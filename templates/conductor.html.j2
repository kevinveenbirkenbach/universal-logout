<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ text_direction }}">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, private">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ t.title }}🍪</title>
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    /* Status colors */
    .status-in-process { color: #b8860b; font-weight: 600; }
    .status-success    { color: #228b22; font-weight: 600; }
    .status-failure    { color: #b22222; font-weight: 600; }
    .manual-logout-link { font-weight: 600; }
    #iframe-warning { display: none; margin-bottom: 1rem; }
  </style>
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-4 text-center">{{ t.heading }} 🍪</h1>
    <p class="lead text-center">
      🔐 {{ t.lead }}
    </p>
    <!-- Alert if NOT loaded in iframe -->
    <div id="iframe-warning" class="alert alert-warning text-center" role="alert">
      ⚠️ {{ t.warn_iframe }}<br />
      {{ t.warn_configure }}
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-bordered align-middle">
        <thead class="table-light text-center">
          <tr>
            <th scope="col">🌐 {{ t.th_service }}</th>
            <th scope="col">⚙️ {{ t.th_status }}</th>
            <th scope="col">🔨 {{ t.th_manual }}</th>
          </tr>
        </thead>
        <tbody>
          {% for host in domains %}
          <tr>
            <td>
              🌐 <a href="{{ host }}" target="_blank" rel="noopener noreferrer">{{ host }}</a>
            </td>
            <td id="status-{{ loop.index0 }}" class="status-in-process text-center">
              🔄 {{ t.st_pending }}
            </td>
            <td class="text-center">
              <!-- Add a static cache-buster to discourage caching of manual clicks -->
              <a
                href="{{ host }}/logout?manual=1"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline-primary btn-sm manual-logout-link"
              >💥 {{ t.manual }}</a>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <p class="text-center mt-4">
      <a href="https://github.com/kevinveenbirkenbach/universal-logout" target="_blank" rel="noopener noreferrer">
        🤖 {{ t.source }}
      </a>
    </p>
  </div>

  <!-- Bootstrap 5 JS Bundle CDN (Popper + Bootstrap JS) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Show warning if not in an iframe
    if (window.self === window.top) {
      document.getElementById('iframe-warning').style.display = 'block';
    }

    const domains = {{ domains | tojson | safe }};
    const LABEL_DONE = {{ t.st_done | tojson | safe }};
    const LABEL_FAILED = {{ t.st_failed | tojson | safe }};

    const issuer = new URLSearchParams(window.location.search).get("iss") || document.referrer;
    let parentOrigin = null;
    try {
      parentOrigin = issuer ? new URL(issuer).origin : null;
    } catch {
      parentOrigin = null;
    }

    const report = (payload) => {
      try {
        if (parentOrigin && window.self !== window.top) {
          window.parent.postMessage(Object.assign({ source: "universal-logout" }, payload), parentOrigin);
        }
      } catch {}
    };

    report({ type: "start", domains });

    const sweep = domains.map((host, index) => {
      const bust = Date.now().toString(36) + Math.random().toString(36).slice(2);
      const url = `${host}/logout?t=${bust}`;

      return fetch(url, {
        credentials: "include",
        cache: "no-store",
        mode: "cors",
        keepalive: true
      })
      .then((res) => res.ok)
      .catch(() => false)
      .then((ok) => {
        report({ type: "host", host, ok });
        try {
          const cell = document.getElementById(`status-${index}`);
          cell.textContent = (ok ? "✅ " : "❌ ") + (ok ? LABEL_DONE : LABEL_FAILED);
          cell.className = `${ok ? "status-success" : "status-failure"} text-center`;
        } catch {}
        return ok;
      });
    });

    Promise.allSettled(sweep).then((results) => {
      report({
        type: "done",
        total: results.length,
        failed: results.filter((r) => r.status !== "fulfilled" || !r.value).length
      });
    });
  </script>
</body>
</html>
